<html>
  <head>
    <title>Casa</title>
  </head>
  <body>
    <h1>Casa control</h1>
    <form method="post">
      <select name="operating_mode">
        <option value="0" <%="selected" if operating_mode == 0%>>Stop</option>
        <option value="1" <%="selected" if operating_mode == 1%>>Away</option>
        <option value="2" <%="selected" if operating_mode == 2%>>Home</option>
        <option value="3" <%="selected" if operating_mode == 3%>>Boost</option>
        <option value="4" <%="selected" if operating_mode == 4%>>Travelling</option>
      </select>
      <input type="submit" name="action" value="Set operating mode">
    </form>
    <h2>Fireplace</h2>
    <p>
      <%=fireplace_active == 1 ? "Active, #{timed_function_time_left} min left" : "Not active"%>
    </p>
    <form method="post">
      <select name="fireplace_level">
        <option value="0" <%="selected" if fireplace_level == 0%>>Low (1/3 of max)</option>
        <option value="1" <%="selected" if fireplace_level == 1%>>Normal (2/3 of max)</option>
        <option value="2" <%="selected" if fireplace_level == 2%>>High (max)</option>
      </select>
      <button name="action" value="start_fireplace">Start</button>
      <button name="action" value="stop_fireplace">Stop</button>
    </form>
    <h2>Status</h2>
    <table>
      <%status.each do |key, value|%>
        <tr>
          <td><%=key%></td>
          <td><%=value%></td>
        </tr>
      <%end%>
    </table>
    <h2>Measurments</h2>
    <table>
      <%measurements.each do |key, value|%>
        <tr>
          <td><%=key%></td>
          <td><%=value%></td>
        </tr>
      <%end%>
    </table>
  </body>
</html>
