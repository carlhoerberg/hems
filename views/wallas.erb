<% v = state["values"] %>
# TYPE wallas_ble_connected gauge
wallas_ble_connected <%=state["connected"] ? 1 : 0%>

# TYPE wallas_temperature gauge
wallas_temperature{name="Room"} <%=v["room_temperature"]%>
wallas_temperature{name="Coolant"} <%=v["coolant_temperature"]%>

# TYPE wallas_target_temperature gauge
wallas_target_temperature{name="Room"} <%=v["target_room_temperature"]%>
wallas_target_temperature{name="Coolant"} <%=v["target_coolant_temperature"]%>

# TYPE wallas_supply_voltage gauge
wallas_supply_voltage <%=v["supply_voltage"]%>

# TYPE wallas_starts counter
wallas_starts <%=v["starts"]%>

# The panel's own state code, 0 off and 3 idle/paused
# TYPE wallas_state gauge
wallas_state <%=v["state"]%>

# TYPE metrics_gather_time gauge
metrics_gather_time{device="wallas"} <%=Process.clock_gettime(Process::CLOCK_MONOTONIC) - t%>
