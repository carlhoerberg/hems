<%esc = ->(s) { s.to_s.gsub(/[\\"\n]/) { |c| c == "\n" ? "\\n" : "\\#{c}" } }%>
<%devices.each do |device_id, metrics|%>
<%info = device_info[device_id] || {}%>
<%components = info[:components] || {}%>
<%device_labels = info[:name] ? %(,device_name="#{esc.(info[:name])}") : ""%>
<%metrics.select { |_, m| m[:v] && m[:ts] / 1000 > Time.now.to_i - 3600 }.each do |key, m|%>
<%name, component = key.to_s.split("/", 2)%>
<%c = (component && components[component]) || {}%>
<%labels = +%(device_id="#{device_id}"#{device_labels})%>
<%labels << %(,name="#{esc.(c[:name])}") if c[:name]%>
<%labels << %(,appliance_type="#{esc.(c[:appliance_type])}") if c[:appliance_type]%>
# TYPE <%=name%> <%=m[:counter] ? "counter" : "gauge"%>
<%=name%>{<%=labels%>} <%=m[:v]%> <%=m[:ts]%>
<%end%>
<%end%>

# TYPE metrics_gather_time gauge
metrics_gather_time{device="shelly"} <%=Process.clock_gettime(Process::CLOCK_MONOTONIC) - t%>
