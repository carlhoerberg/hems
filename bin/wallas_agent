#!/usr/bin/env python3
"""Local BLE gateway for the Wallas 40 EA, to run on a Pi within radio range of
the 3008 control panel.

The panel has no network interface and its cloud validates certificates, so
Bluetooth is the only local way in. It talks a plain ASCII protocol over GATT:
notifications on d769facf arrive as "<field>:<value>", one field per
notification, the whole set burst on connect. Temperatures are hundredths of a
Kelvin, so 34115 is 68.00 degrees.

This keeps the link up, parses the fields and serves them as JSON to hems, which
cannot reach the panel itself. Pair the panel once by hand before starting it
(bluetoothctl: agent KeyboardOnly, pair <mac>, code from the panel display).

  bin/wallas_agent --mac 3C:E9:0E:96:69:3E [--port 8080] [--allow-write]

  GET  /state  -> {"fields": {...}, "values": {...}, "age": 12.3}
  POST /set    -> {"target_room_temperature": 21.5}, needs --allow-write
  POST /set    -> {"extra_water_pump": 1}
  POST /stop   -> stop the heater, POST /start to start it (assumed verb)
  POST /write  -> body "SET RTT=29465", raw command, needs --allow-write
"""

import argparse
import json
import re
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

import dbus
import dbus.mainloop.glib
from gi.repository import GLib

SERVICE = "c6fbdd3c-7123-4c9e-86ab-005f1a7eda01"
# The app subscribes to all of these, and the panel then bursts its whole field
# set every 20 seconds or so. Subscribing to fewer means it goes quiet after the
# first burst.
NOTIFY = [
    "d769facf-a4da-47ba-9253-65359ee480fb",  # the numbered fields
    "cc00e463-2850-4e21-a255-6764dac0c275",
    "8d4bcc34-cbbf-42ac-8972-0b35ddcfd03a",  # "S0.A:0"
    "000018b3-f642-42dd-b048-aeb8e76e93de",  # wifi status
    "00005b64-2745-479b-b006-56f3b4043c2c",  # update status
]
COMMAND = "b88e098b-e464-4b54-b827-79eb2b150a9f"

# Commands are ASCII too, read off the phone app with HCI snoop logs: it writes
# "SET RTT=30415" for a 31.00 degree room target, "SET EWP=1" for the extra water
# pump and a bare "STOP" to stop the heater. START is not in either capture but
# turned out to be the verb, it started the heater.
SETTERS = {
    "target_room_temperature": ("RTT", "temperature"),
    "extra_water_pump": ("EWP", "bool"),
}
ACTIONS = {"stop": "STOP", "start": "START"}

# Field meanings, from watching the panel and from its own display pages: 5
# followed a setpoint change from 35 to 32, 6 is the coolant temperature, 7
# matches the target water temperature, 8 the supply voltage, and 0/1 were 0/0
# with the heater off against 3/64 with it on. 9, 16 and 21 match the Device
# Stats and Device Info pages (starts, serial number, heater software), and 10 in
# seconds matches the usage hours there. Note the panel's own software version is
# the 5b63 read, not field 21.
KELVIN = 27315  # hundredths of a Kelvin at 0 degrees
NOISY = {10}    # runtime, ticks every second the burner runs

# What field 1 goes through over a cycle. State (field 0) is only on or off, the
# phase is in here.
PHASES = {
    0: "Off",
    17: "Ignition",
    18: "Ignition",
    22: "Ignition",
    23: "Ignition",
    33: "Full burn",
    129: "Cooldown",
    64: "Paused",
}
FIELDS = {
    0: ("state", None),                 # 0 off, 3 on
    # field 1 is a phase code, not the percentage on the display: 0 off, then 17,
    # 18, 22, 23 through the ignition ramp, 33 at full burn, 129 for the cooldown
    # after the burner stops (about five minutes, runtime frozen, coolant
    # falling) and 64 once settled into pause. field 2 came on three minutes into
    # a warm start, together with the coolant reading dropping as cooler loop
    # water reached the sensor, so it is the circulation pump.
    1: ("phase_code", None),
    2: ("water_pump", None),
    3: ("extra_water_pump", None),      # flipped when the app wrote SET EWP=1
    4: ("room_temperature", "temperature"),
    5: ("target_room_temperature", "temperature"),
    6: ("coolant_temperature", "temperature"),
    7: ("target_coolant_temperature", "temperature"),
    8: ("supply_voltage", "centi"),
    9: ("starts", None),
    10: ("runtime_seconds", None),      # advances only while the burner fires
    15: ("limit_15", "temperature"),
    16: ("serial_number", None),
    17: ("model", None),
    19: ("limit_19", "temperature"),
    21: ("heater_version", None),
}


def convert(kind, raw):
    """Scale a raw field value, keeping the raw string when it is not a number"""
    try:
        number = int(raw)
    except ValueError:
        return raw
    if kind == "temperature":
        return round((number - KELVIN) / 100.0, 2)
    if kind == "centi":
        return round(number / 100.0, 2)
    return number


class Panel:
    def __init__(self, mac, allow_write):
        self.mac = mac
        self.allow_write = allow_write
        self.lock = threading.Lock()
        self.fields = {}        # raw "index" -> value, as the panel sends them
        self.status = None      # the separate 8d4bcc34 string
        self.updated_at = 0.0
        self.connected = False
        self.notifying = False   # subscriptions are per connection, and BlueZ
                                 # keeps the link across a restart of this agent

        dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
        self.bus = dbus.SystemBus()
        self.path = "/org/bluez/hci0/dev_" + mac.replace(":", "_")
        self.bus.add_signal_receiver(
            self.on_properties_changed,
            dbus_interface="org.freedesktop.DBus.Properties",
            signal_name="PropertiesChanged",
            path_keyword="path",
        )

    # --- BlueZ plumbing ---

    def device(self):
        return dbus.Interface(self.bus.get_object("org.bluez", self.path), "org.bluez.Device1")

    def properties(self, path, interface):
        obj = dbus.Interface(self.bus.get_object("org.bluez", path), "org.freedesktop.DBus.Properties")
        return obj.GetAll(interface)

    def characteristics(self):
        """Map characteristic UUID to object path"""
        manager = dbus.Interface(self.bus.get_object("org.bluez", "/"), "org.freedesktop.DBus.ObjectManager")
        found = {}
        for path, interfaces in manager.GetManagedObjects().items():
            char = interfaces.get("org.bluez.GattCharacteristic1")
            if char and str(path).startswith(self.path):
                found[str(char["UUID"])] = str(path)
        return found

    def connect(self):
        device = self.device()
        props = self.properties(self.path, "org.bluez.Device1")
        if not props.get("Connected"):
            print("connecting to %s" % self.mac, flush=True)
            device.Connect()
            for _ in range(20):
                if self.properties(self.path, "org.bluez.Device1").get("ServicesResolved"):
                    break
                time.sleep(0.5)
        self.connected = True
        subscribed = 0
        chars = self.characteristics()
        for uuid in NOTIFY:
            path = chars.get(uuid)
            if not path:
                print("characteristic %s not found" % uuid, flush=True)
                continue
            char = dbus.Interface(self.bus.get_object("org.bluez", path), "org.bluez.GattCharacteristic1")
            try:
                char.StartNotify()
                subscribed += 1
                print("subscribed %s" % uuid, flush=True)
            except dbus.DBusException as e:
                if "Already" in str(e):
                    subscribed += 1
                else:
                    print("subscribe %s failed: %s" % (uuid, e), flush=True)
        self.notifying = subscribed > 0

    def set(self, name, value):
        """Turn a named value into the panel's own command syntax"""
        if name not in SETTERS:
            raise KeyError("no command known for %r, known: %s" % (name, ", ".join(SETTERS)))
        verb, kind = SETTERS[name]
        if kind == "temperature":
            raw = int(round(float(value) * 100)) + KELVIN
        elif kind == "bool":
            raw = 1 if value in (True, 1, "1", "on", "true") else 0
        else:
            raw = int(value)
        self.write("SET %s=%d" % (verb, raw))

    def action(self, name):
        """A command that takes no value, such as STOP"""
        if name not in ACTIONS:
            raise KeyError("no command known for %r, known: %s" % (name, ", ".join(ACTIONS)))
        self.write(ACTIONS[name])

    def write(self, payload):
        if not self.allow_write:
            raise PermissionError("started without --allow-write")
        path = self.characteristics().get(COMMAND)
        if not path:
            raise RuntimeError("command characteristic not available")
        char = dbus.Interface(self.bus.get_object("org.bluez", path), "org.bluez.GattCharacteristic1")
        char.WriteValue([dbus.Byte(b) for b in payload.encode()], {})
        print("wrote %r" % payload, flush=True)

    # --- notifications ---

    def on_properties_changed(self, interface, changed, invalidated, path=None):
        if interface == "org.bluez.Device1" and "Connected" in changed:
            self.connected = bool(changed["Connected"])
            if not self.connected:
                self.notifying = False
            print("connected: %s" % self.connected, flush=True)
            return
        if interface != "org.bluez.GattCharacteristic1" or "Value" not in changed:
            return
        text = bytes(changed["Value"]).decode("utf-8", "replace")
        with self.lock:
            match = re.match(r"^(\d+):(.*)$", text)
            if match:
                index, value = int(match.group(1)), match.group(2)
                previous = self.fields.get(index)
                # Log changes of the discrete fields, so a run of the heater
                # leaves a trace in the journal and the unidentified ones can be
                # read afterwards. The temperatures, the voltage and the runtime
                # move constantly and would drown it.
                name, kind = FIELDS.get(index, ("field_%d" % index, None))
                if previous is not None and previous != value and kind is None \
                        and index not in NOISY:
                    print("%s (%d): %s -> %s" % (name, index, previous, value), flush=True)
                self.fields[index] = value
                self.updated_at = time.time()
            elif text.strip():
                self.status = text.strip()
                self.updated_at = time.time()

    def snapshot(self):
        with self.lock:
            fields = dict(self.fields)
            status = self.status
            updated_at = self.updated_at
        values = {}
        for index, raw in fields.items():
            name, kind = FIELDS.get(index, ("field_%d" % index, None))
            values[name] = convert(kind, raw)
        if "state" in values:
            values["on"] = values["state"] != 0
        if "phase_code" in values:
            code = values["phase_code"]
            values["phase"] = PHASES.get(code, "Unknown (%s)" % code)
        return {
            "connected": self.connected,
            "age": round(time.time() - updated_at, 1) if updated_at else None,
            "status": status,
            "values": values,
            "fields": {str(k): v for k, v in sorted(fields.items())},
        }

    # The panel streams on its own once subscribed, so the only job here is to
    # notice a dropped link or a stalled stream and reconnect. Reconnecting
    # immediately after our own disconnect makes BlueZ abort the attempt
    # (le-connection-abort-by-local), hence the pause before connecting again.
    def watchdog(self, poll, stale_after):
        started = time.time()
        while True:
            try:
                connected = bool(self.properties(self.path, "org.bluez.Device1").get("Connected"))
                quiet = time.time() - (self.updated_at or started)
                if not connected:
                    self.connect()
                elif not self.notifying:
                    # connected but not subscribed, which is where a restart of
                    # this agent leaves us: BlueZ holds the link, we hold nothing
                    print("connected without subscriptions, subscribing", flush=True)
                    self.connect()
                elif quiet > stale_after:
                    print("no data for %ds, reconnecting" % quiet, flush=True)
                    self.device().Disconnect()
                    time.sleep(5)
                    self.connect()
            except dbus.DBusException as e:
                print("watchdog: %s" % e, flush=True)
            time.sleep(poll)

class Handler(BaseHTTPRequestHandler):
    panel = None

    def log_message(self, *args):
        pass

    def do_GET(self):
        if self.path.rstrip("/") not in ("", "/state"):
            self.send_error(404)
            return
        body = json.dumps(self.panel.snapshot(), indent=1).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        route = self.path.rstrip("/")
        if route in ("/" + a for a in ACTIONS):
            try:
                self.panel.action(route.lstrip("/"))
            except PermissionError as e:
                self.send_error(403, str(e))
                return
            except Exception as e:
                self.send_error(502, str(e))
                return
            self.send_response(204)
            self.end_headers()
            return
        if route not in ("/write", "/set"):
            self.send_error(404)
            return
        length = int(self.headers.get("Content-Length", 0))
        payload = self.rfile.read(length).decode().strip()
        try:
            if route == "/set":
                for name, value in json.loads(payload).items():
                    self.panel.set(name, value)
            else:
                if not re.match(r"^[\w.:,= -]{1,64}$", payload):
                    self.send_error(400, "unexpected payload")
                    return
                self.panel.write(payload)
        except PermissionError as e:
            self.send_error(403, str(e))
            return
        except (KeyError, ValueError) as e:
            self.send_error(400, str(e))
            return
        except Exception as e:
            self.send_error(502, str(e))
            return
        self.send_response(204)
        self.end_headers()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--mac", default="3C:E9:0E:96:69:3E")
    parser.add_argument("--port", type=int, default=8080)
    parser.add_argument("--poll", type=int, default=15, help="seconds between link checks")
    parser.add_argument("--stale", type=int, default=120,
                        help="reconnect when no notification has arrived for this long")
    parser.add_argument("--allow-write", action="store_true", help="enable POST /write")
    args = parser.parse_args()

    panel = Panel(args.mac, args.allow_write)
    Handler.panel = panel
    threading.Thread(target=panel.watchdog, args=(args.poll, args.stale), daemon=True).start()
    server = ThreadingHTTPServer(("0.0.0.0", args.port), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    print("serving state on port %d, writes %s" %
          (args.port, "enabled" if args.allow_write else "disabled"), flush=True)
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
